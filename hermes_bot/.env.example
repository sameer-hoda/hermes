# ── Required ─────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Owner (auto-detected from bridge, override if needed) ──
# OWNER_PHONE_NUMBER=91XXXXXXXXXX

# ── MeChat — the chat Hermes uses to talk to you ──
# Use a personal "notes" group JID (e.g. 91XXXXXXXXXX-1633800754@g.us).
# If unset, defaults to <OWNER_PHONE_NUMBER>-1633800754@g.us on the bridge
# and the self-chat JID on the Python side.
# MECHAT_JID=91XXXXXXXXXX-1633800754@g.us

# ── Bridge paths (defaults below work out of the box) ──
# MESSAGES_DB_PATH=../components/wa_bridge/store/messages.db
# WHATSAPP_DB_PATH=../components/wa_bridge/store/whatsapp.db
# WA_API_URL=http://localhost:8080
# BRIDGE_PORT=8080   # change if another local server occupies 8080

# ── Hermes-specific ──────────────────────────────
# HERMES_DB_PATH=hermes_bot/store/hermes.db
# GEMINI_MODEL_FAST=gemini-3.1-flash-lite-preview
# SESSION_TIMEOUT_MINUTES=60
# MAX_GROUPS_PER_SEARCH=10
# SEARCH_LOOKBACK_DAYS=14
# SEARCH_MESSAGES_PER_GROUP=200

# ── Optional features ────────────────────────────
# CRON_ENABLED=1
